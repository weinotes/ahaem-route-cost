  "description": "An open-source calculator for the true fixed and percentage cost of moving crypto.",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://weinotes.github.io/ahaem-route-cost/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weinotes/ahaem-route-cost.git"
  },
